# Local development: the browser calls the Go API directly.
NEXT_PUBLIC_API_URL=https://civicfix-backend-553k.onrender.com

# Production (e.g. Vercel): don't set NEXT_PUBLIC_API_URL. The browser then calls
# /api on this domain and Next.js forwards it to BACKEND_URL.
# BACKEND_URL=https://civicfix-api.onrender.com
